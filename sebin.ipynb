import numpy as np
import pandas as pd
import matplotlib.pyplot as plt

from sklearn.model_selection import train_test_split, cross_val_score, KFold
from sklearn.neighbors import KNeighborsClassifier
from sklearn.preprocessing import StandardScaler
from sklearn.metrics import accuracy_score

# ==========================================
# 1. LOAD AND PREPROCESS TITANIC DATASET
# ==========================================
df = pd.read_csv('titanic.csv')

# Select features and remove missing values
df = df[['Survived', 'Pclass', 'Sex', 'Age', 'SibSp', 'Parch', 'Fare']].dropna()
df['Sex'] = df['Sex'].map({'male': 0, 'female': 1})

X = df[['Pclass', 'Sex', 'Age', 'SibSp', 'Parch', 'Fare']].values
y = df['Survived'].values

print(f"Dataset Shape: {X.shape}")
print(f"Target counts (0: Died, 1: Survived): {np.bincount(y)}")

# Feature scaling
scaler = StandardScaler()
X_scaled = scaler.fit_transform(X)

# ==========================================
# 2. EXPERIMENT 1: SINGLE TRAIN-TEST SPLIT (1 RUN)
# ==========================================
X_train, X_test, y_train, y_test = train_test_split(X_scaled, y, test_size=0.20, random_state=42)

model = KNeighborsClassifier(n_neighbors=5)
model.fit(X_train, y_train)

y_pred = model.predict(X_test)
single_acc = accuracy_score(y_test, y_pred)
print(f"\n1. Single Train-Test Split Accuracy: {single_acc * 100:.2f}%")

# ==========================================
# 3. EXPERIMENT 2: 30 REPEATED TRAIN-TEST SPLITS
# ==========================================
repeated_scores = []

for seed in range(30):
    X_tr, X_te, y_tr, y_te = train_test_split(X_scaled, y, test_size=0.20, random_state=seed)
    knn = KNeighborsClassifier(n_neighbors=5)
    knn.fit(X_tr, y_tr)
    pred = knn.predict(X_te)
    repeated_scores.append(accuracy_score(y_te, pred))

repeated_scores = np.array(repeated_scores)

print("\n2. Repeated Train-Test Splits (30 Runs):")
print(f"   - Mean Accuracy : {repeated_scores.mean() * 100:.2f}%")
print(f"   - Minimum Score : {repeated_scores.min() * 100:.2f}%")
print(f"   - Maximum Score : {repeated_scores.max() * 100:.2f}%")
print(f"   - Score Range   : {(repeated_scores.max() - repeated_scores.min()) * 100:.2f}% variation due to random split!")

# ==========================================
# 4. EXPERIMENT 3: 5-FOLD CROSS-VALIDATION
# ==========================================
kf = KFold(n_splits=5, shuffle=True, random_state=42)
cv_scores = cross_val_score(KNeighborsClassifier(n_neighbors=5), X_scaled, y, cv=kf, scoring='accuracy')

print("\n3. 5-Fold Cross-Validation:")
for i, score in enumerate(cv_scores, 1):
    print(f"   - Fold {i}: {score * 100:.2f}%")
print(f"   - 5-Fold CV Mean Accuracy: {cv_scores.mean() * 100:.2f}% (+/- {cv_scores.std() * 100:.2f}%)")

# ==========================================
# 5. BAR GRAPH VISUALIZATION (Matplotlib)
# ==========================================
methods = ['Single Split', '30 Repeated Splits (Mean)', '5-Fold CV (Mean)']
scores = [single_acc * 100, repeated_scores.mean() * 100, cv_scores.mean() * 100]
errors = [0, repeated_scores.std() * 100, cv_scores.std() * 100]

plt.figure(figsize=(8, 5))
bars = plt.bar(methods, scores, yerr=errors, capsize=6, color=['#38bdf8', '#4ade80', '#f87171'], edgecolor='black', width=0.5)

plt.ylim(60, 95)
plt.ylabel('Accuracy (%)', fontsize=11)
plt.title('Evaluation Reliability on Titanic: Single Split vs Repeated Splits vs 5-Fold CV', fontsize=11, fontweight='bold')
plt.grid(axis='y', linestyle='--', alpha=0.7)

for bar in bars:
    height = bar.get_height()
    plt.text(bar.get_x() + bar.get_width()/2, height + 1, f'{height:.2f}%', ha='center', fontweight='bold')

plt.tight_layout()
plt.savefig('bar_graphs.png', dpi=130)
plt.show()

# ==========================================
# 6. SUMMARY TABLE
# ==========================================
summary = pd.DataFrame({
    'Method': ['Single Split', '30 Repeated Splits', '5-Fold CV'],
    'Accuracy': [
        f"{single_acc * 100:.2f}%",
        f"{repeated_scores.mean() * 100:.2f}%",
        f"{cv_scores.mean() * 100:.2f}%"
    ],
    'Score Range (Min - Max)': [
        'Single Run',
        f"{repeated_scores.min() * 100:.2f}% - {repeated_scores.max() * 100:.2f}%",
        f"{cv_scores.min() * 100:.2f}% - {cv_scores.max() * 100:.2f}%"
    ]
})

print("\nSummary Table:")
print(summary.to_string(index=False))
